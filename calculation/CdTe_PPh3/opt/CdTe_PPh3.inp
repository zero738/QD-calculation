        N_DIIS  7
      &END OT
      &OUTER_SCF
        MAX_SCF 200 #Maximum number of steps of outer SCF
        EPS_SCF 1.0E-06 #Convergence threshold of outer SCF
      &END OUTER_SCF
      &PRINT
        &RESTART #Note: Use "&RESTART OFF" can prevent generating .wfn file
