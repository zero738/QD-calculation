# SCNet package runtime evidence is produced only after manual server jobs and
# must not be confused with the unrun package committed in this PR.
interface_thickness_prototype/server_scnet_2024_1/runs/
interface_thickness_prototype/server_scnet_2024_1/pipeline_jobs.json
interface_thickness_prototype/server_scnet_2024_1/scnet_results_bundle.tar.gz
interface_thickness_prototype/server_scnet_2024_1/large_optional_files_manifest.txt
interface_thickness_prototype/server_scnet_2024_1/results/bundle_sha256.txt
interface_thickness_prototype/server_scnet_2024_1/results/.finalize_lock/
interface_thickness_prototype/scnet_upload_bundle.zip
interface_thickness_prototype/.scnet_bundle_stage/
interface_thickness_prototype/server_scnet_2024_1/*.out

# Keep only the two small (about 117 kB each) cubes from the one audited
# six-atom research_lite run; larger future slab cubes remain ignored.
!interface_thickness_prototype/research_lite/runs/cu2te_bulk/electron_density.cube
!interface_thickness_prototype/research_lite/runs/cu2te_bulk/hartree_potential.cube
!interface_thickness_prototype/research_lite/runs/cu2te_bulk/history/attempt_01_explicit_gamma_kpoints/electron_density.cube
!interface_thickness_prototype/research_lite/runs/cu2te_bulk/history/attempt_01_explicit_gamma_kpoints/hartree_potential.cube

# Potentially large model runs are not versioned. The three deliberately small
# smoke-test outputs and curated JSON/CSV evidence remain tracked.
interface_thickness_prototype/models/*/*.out
interface_thickness_prototype/models/*/*.parsed.json
