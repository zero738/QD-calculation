    &END COORD
    &KIND Cd
      ELEMENT Cd
      BASIS_SET DZVP-MOLOPT-SR-GTH-q12
      POTENTIAL GTH-PBE-q12
      # Matching GTH valence setting q12
    &END KIND
    &KIND Te
      ELEMENT Te
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
      # Matching GTH valence setting q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
