# Generated by scripts/generate_research_lite_inputs.py
# PROFILE research_lite: trend-oriented starting point, not publication-converged.
# The polar CdTe(111) slabs may only support relative trend checks after further convergence work.
&GLOBAL
  PROJECT rl_c50_gamma
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD GPW
      EPS_DEFAULT 1e-12
    &END QS
    &POISSON
      PERIODIC XY
      PSOLVER ANALYTIC
    &END POISSON
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1e-06
      MAX_SCF 150
      ADDED_MOS 40
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 500
      &END SMEAR
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.15
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
          BACKUP_COPIES 1
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    # Implicit Gamma: no KPOINTS section, preserving CP2K 2024.3 PDOS/LDOS support.
    &PRINT
      # CP2K DOS Density is a normalized histogram fraction, not a raw total
      # number of KS orbitals. Comparable spectra are rebuilt from unique MOs.
      &DOS ON
        DELTA_E 0.00183747
        FILENAME =total_dos.dat
      &END DOS
      &PDOS ON
        NLUMO 40
        COMPONENTS
      # LDOS group 1: CdTe_substrate
      &LDOS
        LIST 1..78
        COMPONENTS
      &END LDOS
      # LDOS group 2: Cu2Te_film
      &LDOS
        LIST 79..126
        COMPONENTS
      &END LDOS
      # LDOS group 3: CdTe_interface_top_Te
      &LDOS
        LIST 6 12 18 24 30 36 42 48 54 60 66 72 78
        COMPONENTS
      &END LDOS
      # LDOS group 4: Cu2Te_interface_bottom_Cu
      &LDOS
        LIST 79..80 85..86 91..92 97..98 103..104 109..110 115..116 121..122
        COMPONENTS
      &END LDOS
      &END PDOS
      # CP2K V_HARTREE_CUBE has the opposite sign to the conventional
      # electrostatic potential used by the post-processing code.
      &V_HARTREE_CUBE ON
        FILENAME =hartree_potential.cube
        STRIDE 4 4 2
      &END V_HARTREE_CUBE
      &E_DENSITY_CUBE ON
        FILENAME =electron_density.cube
        STRIDE 4 4 2
      &END E_DENSITY_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A     16.037181797      3.968173383      0.000000000
      B      4.582051942     15.872693533      0.000000000
      C      0.000000000      0.000000000     35.816346673
      PERIODIC XY
    &END CELL
