# Generated by scripts/generate_research_lite_inputs.py
# PROFILE research_lite: trend-oriented starting point, not publication-converged.
# The polar CdTe(111) slabs may only support relative trend checks after further convergence work.
&GLOBAL
  PROJECT rl_cu2te_bulk_k221
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD GPW
      EPS_DEFAULT 1e-12
    &END QS
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1e-06
      MAX_SCF 150
      ADDED_MOS 40
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 500
      &END SMEAR
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.15
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
          BACKUP_COPIES 1
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 1
    &END KPOINTS
    &PRINT
      &DOS ON
        DELTA_E 0.00183747
        FILENAME =total_dos.dat
      &END DOS
      # PDOS/LDOS intentionally omitted for this explicit k-point check:
      # CP2K 2024.3 reports that projected DOS is not implemented for KPOINTS.
      # CP2K's V_HARTREE_CUBE contains the electron+ion electrostatic potential
      # with the opposite sign to the conventional physical potential.
      &V_HARTREE_CUBE ON
        FILENAME =hartree_potential.cube
        STRIDE 4 4 2
      &END V_HARTREE_CUBE
      &E_DENSITY_CUBE ON
        FILENAME =electron_density.cube
        STRIDE 4 4 2
      &END E_DENSITY_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A      4.237000000      0.000000000      0.000000000
      B     -2.118500000      3.669349636      0.000000000
      C      0.000000000      0.000000000      7.247007170
      PERIODIC XYZ
    &END CELL
    &COORD
      Cu     -0.000000000      2.446233091      1.159521147
      Cu      2.118500000      1.223116545      1.159521147
      Cu      2.118500000      1.223116545      6.087486023
      Cu     -0.000000000      2.446233091      6.087486023
      Te      0.000000000      0.000000000      2.217584194
      Te      0.000000000      0.000000000      5.029422976
    &END COORD
    &KIND Te
      ELEMENT Te
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
      # Matching GTH valence setting q6
    &END KIND
    &KIND Cu
      ELEMENT Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH-q11
      POTENTIAL GTH-PBE-q11
      # Matching GTH valence setting q11
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
