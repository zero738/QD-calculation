# Generated by scripts/generate_cp2k_inputs.py
# SMOKE TEST ONLY: PBE/DZVP, cutoff, Gamma point and model size are not converged.
&GLOBAL
  PROJECT 02_cu2te_bulk_sp
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1e-06
      MAX_SCF 80
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 500
      &END SMEAR
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.20
        NBROYDEN 8
      &END MIXING
      # Wavefunction restart printing is disabled for the minimal smoke test:
      # the k-point restart was tens of MB even for a six-atom cell. Enable it
      # only in a production run with an explicit storage policy.
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME GAMMA
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      A      4.237000000      0.000000000      0.000000000
      B     -2.118500000      3.669349636      0.000000000
      C      0.000000000      0.000000000      7.247007170
      PERIODIC XYZ
    &END CELL
    &COORD
      Cu     -0.000000000      2.446233091      1.159521147
      Cu      2.118500000      1.223116545      1.159521147
      Cu      2.118500000      1.223116545      6.087486023
      Cu     -0.000000000      2.446233091      6.087486023
      Te      0.000000000      0.000000000      2.217584194
      Te      0.000000000      0.000000000      5.029422976
    &END COORD
    &KIND Te
      ELEMENT Te
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
      # Matching GTH valence-electron setting: q6
    &END KIND
    &KIND Cu
      ELEMENT Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH-q11
      POTENTIAL GTH-PBE-q11
      # Matching GTH valence-electron setting: q11
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
