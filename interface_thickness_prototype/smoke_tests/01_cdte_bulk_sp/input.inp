# Generated by scripts/generate_cp2k_inputs.py
# SMOKE TEST ONLY: PBE/DZVP, cutoff, Gamma point and model size are not converged.
&GLOBAL
  PROJECT 01_cdte_bulk_sp
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 0.0001
      MAX_SCF 100
      # Low-memory pipeline smoke choice, not a research SCF profile.
      # In particular, H1 may be conductive and requires diagonalization/smearing
      # before any electronic-structure interpretation.
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.001
      &END OT
      # Disable large restart files in the bounded local smoke run.
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    # No KPOINTS section: CP2K's default is Gamma-only and remains OT-compatible.
  &END DFT
  &SUBSYS
    &CELL
      A      6.480000000      0.000000000      0.000000000
      B      0.000000000      6.480000000      0.000000000
      C      0.000000000      0.000000000      6.480000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cd      0.000000000      0.000000000      0.000000000
      Cd      0.000000000      3.240000000      3.240000000
      Cd      3.240000000      0.000000000      3.240000000
      Cd      3.240000000      3.240000000      0.000000000
      Te      1.620000000      1.620000000      1.620000000
      Te      4.860000000      4.860000000      1.620000000
      Te      4.860000000      1.620000000      4.860000000
      Te      1.620000000      4.860000000      4.860000000
    &END COORD
    &KIND Cd
      ELEMENT Cd
      BASIS_SET DZVP-MOLOPT-SR-GTH-q12
      POTENTIAL GTH-PBE-q12
      # Matching GTH valence-electron setting: q12
    &END KIND
    &KIND Te
      ELEMENT Te
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
      # Matching GTH valence-electron setting: q6
    &END KIND
  &END SUBSYS

&END FORCE_EVAL
